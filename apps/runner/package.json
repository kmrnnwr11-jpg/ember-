{
  "name": "@fluttercursor/runner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=../../.env dist/index.js",
    "smoke": "node scripts/smoke.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/static": "^10.1.3",
    "@fastify/websocket": "^11.3.0",
    "@lydell/node-pty": "^1.2.0-beta.15",
    "@supabase/supabase-js": "^2.116.0",
    "chokidar": "^5.0.0",
    "dockerode": "^5.0.1",
    "fastify": "^5.12.4",
    "jose": "^6.2.12",
    "nanoid": "^6.0.1",
    "pino": "^10.3.1",
    "sharp": "^0.34.5",
    "zod": "^4.6.3"
  },
  "devDependencies": {
    "@types/dockerode": "^4.0.1",
    "@types/node": "^22.20.2",
    "@types/ws": "^8.18.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0",
    "ws": "^8.21.3"
  }
}
