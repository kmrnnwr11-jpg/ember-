# ---------- Runner (§5F) ----------
PORT=8787
LOG_LEVEL=info
CORS_ORIGINS=*

# local = host processes (dev only) | docker = one container per workspace
WORKSPACE_DRIVER=local
WORKSPACES_ROOT=./data/workspaces
HOST_WORKSPACES_ROOT=/srv/fluttercursor/workspaces
DATA_DIR=./data
WORKSPACE_IMAGE=fluttercursor/workspace:latest
WORKSPACE_CPU=2
WORKSPACE_RAM_MB=4096
WORKSPACE_IDLE_MINUTES=30
JOB_TIMEOUT_SECONDS=900

# Supabase (leave empty + DEV_AUTH=true for local dev without accounts)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
DEV_AUTH=true
DEV_JWT_SECRET=change-me-to-a-long-random-string

REDIS_URL=redis://localhost:6379

# AI proxy (Phase 3)
AI_CATALOG_URL=
AI_RATE_LIMIT_PER_MINUTE=120
# true only for local dev (lets the proxy reach http://localhost Ollama etc.)
AI_ALLOW_PRIVATE_BASE_URLS=false
VAULT_MASTER_KEY=
PREVIEW_BASE_DOMAIN=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ---------- Caddy (prod) ----------
BASE_DOMAIN=example.com
ACME_EMAIL=you@example.com

# ---------- IDE client: pass as --dart-define ----------
# SUPABASE_URL=...  SUPABASE_ANON_KEY=...  RUNNER_URL=https://runner.example.com
