{
  "manifest_version": 3,
  "name": "Ember – Play Console helper",
  "version": "0.1.0",
  "description": "Fills the Play Console App content answers for an app built with Ember. Nothing is saved until you press Save yourself.",
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["https://play.google.com/console/*"],
  "action": {
    "default_title": "Ember",
    "default_popup": "popup.html"
  },
  "web_accessible_resources": [
    {
      "resources": ["rules.js"],
      "matches": ["https://play.google.com/*"]
    }
  ],
  "content_scripts": [
    {
      "matches": ["https://play.google.com/console/*"],
      "js": ["content.js"],
      "css": ["panel.css"],
      "run_at": "document_idle"
    }
  ]
}
